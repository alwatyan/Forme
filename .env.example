# Database. Local file for development; for production use a fresh Turso/libSQL database:
#   DATABASE_URL=libsql://your-db.turso.io  and  DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:./forme.db
DATABASE_AUTH_TOKEN=

# Long random string used to sign admin logins. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=

# Public address of the shop (no trailing slash). Used for MyFatoorah return links.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# MyFatoorah. Test: https://apitest.myfatoorah.com  ·  Live Kuwait: https://api.myfatoorah.com
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com
MYFATOORAH_API_KEY=

# Optional: store product pictures in Vercel Blob (needed when hosting on Vercel).
BLOB_READ_WRITE_TOKEN=

# Used by `npm run seed` to create the first admin account.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now
